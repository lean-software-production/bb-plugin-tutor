# Dev-only paths stay out of `git archive`, and so out of the release tarball
# (bb-plugin-tutor-<version>.tgz) that the tutor Feature installs.
/.github/ export-ignore
/docs/ export-ignore
/scripts/ export-ignore
# The vendored brand only feeds generated, committed files (themes/, app/fonts/),
# so nothing in the plugin reads it at run time.
/vendor/ export-ignore
# The launcher ships as its own release asset (install.sh, tutor), not inside
# the plugin archive. host.ts, host/ and layouts/ stay in the archive: the
# plugin needs them.
/standalone/ export-ignore

# The brand repo's files, vendored byte for byte (scripts/sync-brand.ts --check
# compares bytes), so git never rewrites their line endings.
/vendor/brand/** -text
