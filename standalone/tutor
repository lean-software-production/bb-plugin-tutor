#!/bin/sh
# standalone/tutor — install and run a standalone Tutor (a BB server plus an
# enrolled machine) on a student's Mac or Linux computer.
#
# One POSIX sh file: constants, then helper functions, then main() at the
# bottom. Tests source it with TUTOR_SOURCE_ONLY=1 and call its functions
# directly (see standalone/test/helper.bash).
set -eu

TUTOR_NAME=tutor                      # the command's name; a course brand renames it here
# shellcheck disable=SC2034 # stamped at release (Task 20); read by test/pins.test.ts and later tasks
TUTOR_VERSION=0.0.0-dev
# shellcheck disable=SC2034 # the BB the plugin is pinned to; tutor_bb (later tasks) installs it
BB_VERSION=0.45.0
TUTOR_PORT_DEFAULT=47386
# launchd's name for Tutor's server agent, and its plist's file name.
SERVER_LABEL=com.leansoftwareproduction.tutor-server
TUTOR_HOME="${TUTOR_HOME:-$HOME/.tutor}"
# Tutor's own pi (spike constants PI_PACKAGE / PI_VERSION).
PI_PACKAGE=@earendil-works/pi-coding-agent
PI_VERSION=0.85.1
# Provider credentials, by name, that the machine service must not inherit
# from the systemd user manager (amendment 4). Only names are ever read.
KEY_PATTERN='(_API_KEY|_AUTH_TOKEN|_OAUTH_TOKEN)$|^HF_TOKEN$|^AWS_(ACCESS_KEY_ID|SECRET_ACCESS_KEY|SESSION_TOKEN|BEARER_TOKEN_BEDROCK)$|^GOOGLE_APPLICATION_CREDENTIALS$'

# say: one line to stdout, the student's voice; never names BB.
say() {
  printf '%s\n' "$*"
}

# fail: say (joined with newlines if multi-line) to stderr, then exit 1.
fail() {
  say "$@" >&2
  exit 1
}

# log: append a timestamped line to $TUTOR_HOME/logs/launcher.log.
log() {
  mkdir -p "$TUTOR_HOME/logs"
  printf '%s %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$TUTOR_HOME/logs/launcher.log"
}

# config_get <key>: the value for <key> in $TUTOR_HOME/config, or empty.
# Read with grep/sed; the file is never sourced, so a value can't run code.
config_get() {
  key=$1
  [ -f "$TUTOR_HOME/config" ] || return 0
  grep "^$key=" "$TUTOR_HOME/config" 2>/dev/null | tail -n 1 | sed "s/^$key=//"
}

# config_set <key> <value>: atomic rewrite of $TUTOR_HOME/config, mode 0600,
# keeping every other key. Writes config.tmp under umask 077, then mv's it
# into place.
config_set() {
  key=$1
  value=$2
  mkdir -p "$TUTOR_HOME"
  rest="$TUTOR_HOME/config.rest"
  tmp="$TUTOR_HOME/config.tmp"
  if [ -f "$TUTOR_HOME/config" ]; then
    grep -v "^$key=" "$TUTOR_HOME/config" >"$rest" 2>/dev/null || : >"$rest"
  else
    : >"$rest"
  fi
  (
    umask 077
    cat "$rest" >"$tmp"
    printf '%s=%s\n' "$key" "$value" >>"$tmp"
  )
  rm -f "$rest"
  mv "$tmp" "$TUTOR_HOME/config"
}

# os_kind: "linux" or "macos"; fails on anything else.
os_kind() {
  case "$(uname -s)" in
    Linux*) echo linux ;;
    Darwin*) echo macos ;;
    *) fail "Tutor runs on macOS and Linux." ;;
  esac
}

# check_prereqs: Node 22.19+, 24.x or 26.x; npm; git. Each failure names what
# to install; all failures are reported together.
check_prereqs() {
  problems=""

  if node_version_raw=$(node --version 2>/dev/null); then
    node_major=$(printf '%s\n' "$node_version_raw" | sed -n 's/^v\([0-9][0-9]*\)\..*/\1/p')
    node_minor=$(printf '%s\n' "$node_version_raw" | sed -n 's/^v[0-9][0-9]*\.\([0-9][0-9]*\)\..*/\1/p')
    if [ -z "$node_major" ] || [ -z "$node_minor" ]; then
      problems="${problems}Tutor couldn't read your Node version (got '$node_version_raw'); install Node 24.
"
    else
      case "$node_major" in
        22)
          if [ "$node_minor" -lt 19 ]; then
            problems="${problems}Node 22.19 or newer is required (found $node_version_raw); install Node 24.
"
          fi
          ;;
        24 | 26) ;;
        *)
          problems="${problems}Node $node_major is not supported (found $node_version_raw); install Node 24.
"
          ;;
      esac
    fi
  else
    problems="${problems}Node is not installed; install Node 24.
"
  fi

  if ! npm --version >/dev/null 2>&1; then
    problems="${problems}npm is not installed; it comes with Node.
"
  fi

  if ! git --version >/dev/null 2>&1; then
    problems="${problems}git is not installed; install git.
"
  fi

  [ -z "$problems" ] || fail "$problems"
}

# tutor_bb_port: the configured port, or TUTOR_PORT_DEFAULT.
tutor_bb_port() {
  port=$(config_get port)
  [ -n "$port" ] || port=$TUTOR_PORT_DEFAULT
  printf '%s' "$port"
}

# tutor_bb <args...>: run the installed bb CLI against the tutor server,
# logging its output. BB_SERVER_URL always wins over any inherited value
# (amendment 1), and never touches localhost.
tutor_bb() {
  port=$(tutor_bb_port)
  mkdir -p "$TUTOR_HOME/logs"
  BB_SERVER_URL="http://127.0.0.1:$port" "$TUTOR_HOME/server/npm/node_modules/.bin/bb" "$@" >>"$TUTOR_HOME/logs/launcher.log" 2>&1
}

# tutor_bb_json <args...>: like tutor_bb, but its stdout comes back to the
# caller (and is logged too, also when the command fails: with --json, bb
# reports its errors on stdout); stderr goes to the log only.
tutor_bb_json() {
  port=$(tutor_bb_port)
  mkdir -p "$TUTOR_HOME/logs"
  bbj_status=0
  bb_json=$(BB_SERVER_URL="http://127.0.0.1:$port" "$TUTOR_HOME/server/npm/node_modules/.bin/bb" "$@" 2>>"$TUTOR_HOME/logs/launcher.log") \
    || bbj_status=$?
  printf '%s\n' "$bb_json" >>"$TUTOR_HOME/logs/launcher.log"
  [ "$bbj_status" -eq 0 ] || return 1
  printf '%s' "$bb_json"
}

# server_prepare_dirs: create $TUTOR_HOME/server (the bb-server data dir),
# mode 0700.
server_prepare_dirs() {
  mkdir -p "$TUTOR_HOME/server"
  chmod 700 "$TUTOR_HOME/server"
}

# server_restart_needed: note that the running server (if any) is out of
# date — its binaries or its service file changed — so server_start
# restarts it rather than leaving it running. The note is a file, removed
# only once the restart has worked, so a failed restart is retried by the
# next `tutor up`.
server_restart_needed() {
  mkdir -p "$TUTOR_HOME/server"
  : >"$TUTOR_HOME/server/.restart-pending"
}

# server_install: install bb-app at BB_VERSION under $TUTOR_HOME/server/npm.
# npm runs the native modules' install scripts by default (amendment 2; no
# --ignore-scripts). Skipped when already installed at BB_VERSION; a
# (re)install means the running server must restart.
server_install() {
  marker="$TUTOR_HOME/server/npm/.bb-app-version"
  if [ -f "$marker" ] && [ "$(cat "$marker")" = "$BB_VERSION" ]; then
    return 0
  fi
  mkdir -p "$TUTOR_HOME/server/npm" "$TUTOR_HOME/logs"
  npm install --prefix "$TUTOR_HOME/server/npm" "bb-app@$BB_VERSION" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
    || fail "Tutor's server failed to install. Run \`$TUTOR_NAME logs\`."
  printf '%s' "$BB_VERSION" >"$marker"
  server_restart_needed
}

# systemd_quote <string>: a systemd unit-file quoted argument (a
# double-quoted token with backslashes and double quotes escaped, and every
# "%" doubled so systemd's specifier expansion — %h, %t, ... — never fires
# on a literal percent in a path).
systemd_quote() {
  escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g')
  printf '"%s"' "$escaped"
}

# xml_escape <string>: the string with XML's five special characters escaped,
# safe to place inside a plist <string> element.
xml_escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g; s/'"'"'/\&apos;/g'
}

# server_service_file: the tutor server's user-service file — the systemd
# unit on Linux, the launchd plist on macOS.
server_service_file() {
  case "$(os_kind)" in
    linux) printf '%s\n' "$HOME/.config/systemd/user/tutor-server.service" ;;
    macos) printf '%s\n' "$HOME/Library/LaunchAgents/$SERVER_LABEL.plist" ;;
  esac
}

# server_service_write <port>: write the tutor server's user-service file
# (server_service_file) pointing at the installed bb-server on
# 127.0.0.1:<port>, with the node found on PATH. When its content changed
# (a new port, a different node, or a first write), the running server
# must restart.
server_service_write() {
  port=$1
  server_prepare_dirs

  node_bin=$(command -v node) || fail "Node is not installed."
  node_dir=$(dirname "$node_bin")
  bbserver_bin="$TUTOR_HOME/server/npm/node_modules/.bin/bb-server"
  data_dir="$TUTOR_HOME/server"

  case "$(os_kind)" in
    linux)
      unit_dir="$HOME/.config/systemd/user"
      mkdir -p "$unit_dir"
      cat >"$unit_dir/tutor-server.service.new" <<EOF
[Unit]
Description=Tutor server

[Service]
Environment=$(systemd_quote "PATH=$node_dir:/usr/bin:/bin")
ExecStart=$(systemd_quote "$node_bin") $(systemd_quote "$bbserver_bin") --data-dir $(systemd_quote "$data_dir") --server-bind-host 127.0.0.1 --server-port $port
Restart=on-failure

[Install]
WantedBy=default.target
EOF
      ;;
    macos)
      plist_dir="$HOME/Library/LaunchAgents"
      mkdir -p "$plist_dir"
      cat >"$plist_dir/$SERVER_LABEL.plist.new" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$SERVER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$node_bin")</string>
    <string>$(xml_escape "$bbserver_bin")</string>
    <string>--data-dir</string>
    <string>$(xml_escape "$data_dir")</string>
    <string>--server-bind-host</string>
    <string>127.0.0.1</string>
    <string>--server-port</string>
    <string>$port</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml_escape "$node_dir"):/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
EOF
      ;;
  esac

  ssw_file=$(server_service_file)
  if [ -f "$ssw_file" ] && cmp -s "$ssw_file.new" "$ssw_file"; then
    rm -f "$ssw_file.new"
  else
    mv "$ssw_file.new" "$ssw_file"
    server_restart_needed
  fi
}

# launchd_bootstrap <plist>: load a launchd agent. Tries a few times
# (TUTOR_LAUNCHD_TRIES, default 5, a second apart): right after a bootout,
# launchd may still be unloading it, and bootstrap then fails with error 5.
launchd_bootstrap() {
  lb_tries=${TUTOR_LAUNCHD_TRIES:-5}
  lb_try=1
  while ! launchctl bootstrap "gui/$(id -u)" "$1" >>"$TUTOR_HOME/logs/launcher.log" 2>&1; do
    [ "$lb_try" -lt "$lb_tries" ] || return 1
    lb_try=$((lb_try + 1))
    sleep 1
  done
}

# server_start: enable and start the tutor server's user service, so it runs
# now and on every future login (lingering stays off: amendment 8), and
# restart it when server_install or server_service_write said it is out of
# date — `enable --now` alone leaves an already-running server as it was.
# On macOS an agent that is already loaded (every re-run, and after login)
# is left running unless it is out of date; then it is booted out and
# bootstrapped again, so launchd reads the new plist. Every failure says
# what to do; the details go to the log.
server_start() {
  mkdir -p "$TUTOR_HOME/logs"
  ss_log="$TUTOR_HOME/logs/launcher.log"
  ss_pending="$TUTOR_HOME/server/.restart-pending"
  case "$(os_kind)" in
    linux)
      systemctl --user daemon-reload >>"$ss_log" 2>&1 \
        || fail "Tutor couldn't reach your user services (systemctl --user). Run \`$TUTOR_NAME logs\`."
      systemctl --user enable tutor-server.service >>"$ss_log" 2>&1 \
        || fail "Tutor's server didn't start. Run \`$TUTOR_NAME logs\`."
      if [ -f "$ss_pending" ]; then
        systemctl --user restart tutor-server.service >>"$ss_log" 2>&1 \
          || fail "Tutor's server didn't start. Run \`$TUTOR_NAME logs\`."
      else
        systemctl --user start tutor-server.service >>"$ss_log" 2>&1 \
          || fail "Tutor's server didn't start. Run \`$TUTOR_NAME logs\`."
      fi
      ;;
    macos)
      ss_plist=$(server_service_file)
      if launchctl print "gui/$(id -u)/$SERVER_LABEL" >/dev/null 2>&1; then
        if [ -f "$ss_pending" ]; then
          launchctl bootout "gui/$(id -u)" "$ss_plist" >>"$ss_log" 2>&1 || true
          launchd_bootstrap "$ss_plist" || fail "Tutor's server didn't start. Run \`$TUTOR_NAME logs\`."
        fi
      else
        launchd_bootstrap "$ss_plist" || fail "Tutor's server didn't start. Run \`$TUTOR_NAME logs\`."
      fi
      ;;
  esac
  rm -f "$ss_pending"
}

# server_wait_healthy <port>: poll /health until it answers, up to
# TUTOR_HEALTH_TIMEOUT seconds (default 60; tests set it low).
server_wait_healthy() {
  port=$1
  timeout=${TUTOR_HEALTH_TIMEOUT:-60}
  waited=0
  while [ "$waited" -lt "$timeout" ]; do
    if curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
      return 0
    fi
    waited=$((waited + 1))
    sleep 1
  done
  fail "Tutor's server didn't start. Run \`tutor logs\`."
}

# server_configure <port>: point the server at itself, directly, on
# 127.0.0.1 (never localhost).
server_configure() {
  sc_port=$1
  tutor_bb settings general machineServerUrl "http://127.0.0.1:$sc_port" \
    || fail "Tutor couldn't set up its server. Run \`$TUTOR_NAME logs\`."
  tutor_bb settings general defaultMachineAccess direct \
    || fail "Tutor couldn't set up its server. Run \`$TUTOR_NAME logs\`."
}

# plugin_installed_from <folder>: whether `bb plugin list --json` shows
# plugin "tutor" installed from <folder> (as given, or its physical path).
plugin_installed_from() {
  pif_json=$(tutor_bb_json plugin list --json) || return 1
  pif_real=$(cd "$1" && pwd -P)
  printf '%s' "$pif_json" | TUTOR_PLUGIN_DIR="$1" TUTOR_PLUGIN_REAL="$pif_real" node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try {
        const data = JSON.parse(raw);
        const rows = Array.isArray(data) ? data : (data.plugins ?? []);
        const row = rows.find((r) => r.id === "tutor");
        const dirs = [process.env.TUTOR_PLUGIN_DIR, process.env.TUTOR_PLUGIN_REAL];
        process.exit(row && dirs.includes(row.rootDir) ? 0 : 1);
      } catch {
        process.exit(1);
      }
    });' 2>>"$TUTOR_HOME/logs/launcher.log"
}

# plugin_install: install the tutor plugin from the release's own
# ready-to-install archive, bb-plugin-tutor-<v>-built.tgz (dependencies
# installed and built at release; install.sh put it in releases/<v>/) —
# never the network — and pin coach threads to pi. The archive's one
# top-level folder, bb-plugin-tutor-<v>/, is unpacked into a scratch folder
# and moved into place in one step, so an interrupted unpack is redone next
# time rather than skipped. `bb plugin install --yes` (it asks otherwise)
# runs only when the plugin isn't already installed from that folder.
plugin_install() {
  mkdir -p "$TUTOR_HOME/logs"
  release_dir="$TUTOR_HOME/releases/$TUTOR_VERSION"
  plugin_top="bb-plugin-tutor-$TUTOR_VERSION"
  plugin_dir="$release_dir/$plugin_top"
  archive="$release_dir/$plugin_top-built.tgz"
  if [ ! -d "$plugin_dir" ]; then
    [ -f "$archive" ] \
      || fail "Tutor's plugin is missing from $release_dir. Install Tutor again, then run \`$TUTOR_NAME up\`."
    unpack="$release_dir/.unpacking"
    rm -rf "$unpack"
    mkdir -p "$unpack"
    if ! tar -xzf "$archive" -C "$unpack" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
      || [ ! -f "$unpack/$plugin_top/package.json" ]; then
      rm -rf "$unpack"
      fail "Tutor couldn't unpack its plugin. Run \`$TUTOR_NAME logs\`, or install Tutor again."
    fi
    mv "$unpack/$plugin_top" "$plugin_dir"
    rm -rf "$unpack"
  fi
  if ! plugin_installed_from "$plugin_dir"; then
    tutor_bb plugin install "$plugin_dir" --yes \
      || fail "Tutor couldn't install its plugin. Run \`$TUTOR_NAME logs\`."
  fi
  tutor_bb plugin config tutor set coachProvider pi \
    || fail "Tutor couldn't set up its coach. Run \`$TUTOR_NAME logs\`."
}

# Plugins a student doesn't need, switched off once each by tutor_polish.
# BB's own plugins that Tutor runs on (tutor, thread-list, provider-pi and
# the environment-* plugins coach threads use) are never on this list.
TUTOR_QUIET_PLUGINS="account-pool agent-annotations ask-user-question automations bb-guide connect custom-instructions drafts keep-awake monaco-editor navigation plugin-api-docs plugin-api-tester provider-acp push-notifications scheduled-send workflows"
TUTOR_THEME=plugin:tutor:sketchbook

# tutor_polish: Tutor's look and a quieter BB, as the Codespace's tutor
# Feature does. Each decision is made once and recorded in
# $TUTOR_HOME/state/, so a plugin the student turns back on, or a theme they
# choose, stays as they left it. Problems here never stop `tutor up`: they go
# to the log and are tried again next time.
tutor_polish() {
  state="$TUTOR_HOME/state"
  mkdir -p "$state" "$TUTOR_HOME/logs"
  polish_plugins "$state/plugins-quieted" || true
  polish_theme "$state/theme-selected" || true
  return 0
}

# polish_plugins <marker>: switch off each of TUTOR_QUIET_PLUGINS that is on,
# once. An id goes in the marker once it is switched off, found off or found
# missing; a failed switch-off is tried again on the next `tutor up`.
polish_plugins() {
  pp_states=$(tutor_bb_json plugin list --json | node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try {
        const data = JSON.parse(raw);
        for (const p of Array.isArray(data) ? data : (data.plugins ?? [])) {
          process.stdout.write(p.id + " " + (p.enabled === false ? "off" : "on") + "\n");
        }
      } catch { process.exit(1); }
    });' 2>>"$TUTOR_HOME/logs/launcher.log") || return 1
  for pp_id in $TUTOR_QUIET_PLUGINS; do
    if [ -f "$1" ] && grep -qxF "$pp_id" "$1"; then continue; fi
    pp_state=$(printf '%s\n' "$pp_states" | awk -v id="$pp_id" '$1 == id { print $2; exit }')
    if [ "$pp_state" = on ]; then
      tutor_bb plugin disable "$pp_id" || continue
    fi
    printf '%s\n' "$pp_id" >>"$1"
  done
}

# polish_theme <marker>: choose Tutor's Sketchbook theme once, and only while
# BB's default theme is on. A theme BB doesn't offer yet is tried again later.
polish_theme() {
  [ ! -e "$1" ] || return 0
  pt_current=$(tutor_bb_json theme show --json | node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try { process.stdout.write(String(JSON.parse(raw).themeId ?? "")); } catch { process.exit(1); }
    });' 2>>"$TUTOR_HOME/logs/launcher.log") || return 1
  if [ "$pt_current" = default ]; then
    tutor_bb_json theme show "$TUTOR_THEME" --json >/dev/null || return 0
    tutor_bb theme set "$TUTOR_THEME" --json || return 1
  fi
  : >"$1"
}

# machine_id: the newest machine with machineProviderId "manual" in
# `bb machine list --json`, parsed with node (a prerequisite). Mirrors
# standalone/spike/lib.sh's machine_id. Doesn't go through tutor_bb, which
# only logs its output — the JSON is needed back.
machine_id() {
  json=$(tutor_bb_json machine list --json) || return 1
  printf '%s' "$json" | node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try {
        const data = JSON.parse(raw);
        const rows = Array.isArray(data) ? data : (data.machines ?? data.hosts ?? []);
        const manual = rows.filter((row) => (row.machineProviderId ?? row.provider ?? row.providerId) === "manual");
        manual.sort((a, b) => (b.createdAt ?? 0) - (a.createdAt ?? 0));
        if (manual[0] === undefined) process.exit(1);
        console.log(manual[0].id);
      } catch (error) {
        console.error(String(error));
        process.exit(1);
      }
    });' 2>>"$TUTOR_HOME/logs/launcher.log"
}

# machine_connected: whether the enrolled machine (config's machine_id)
# shows status "connected" in `bb machine list --json` right now — the real
# API reports a status string, not a boolean. False when none is enrolled.
machine_connected() {
  id=$(config_get machine_id)
  [ -n "$id" ] || return 1
  json=$(tutor_bb_json machine list --json) || json=""
  printf '%s' "$json" | TUTOR_MACHINE_ID="$id" node -e '
      let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
        try {
          const data = JSON.parse(raw);
          const rows = Array.isArray(data) ? data : (data.machines ?? data.hosts ?? []);
          const row = rows.find((r) => r.id === process.env.TUTOR_MACHINE_ID);
          process.exit(row && row.status === "connected" ? 0 : 1);
        } catch {
          process.exit(1);
        }
      });' 2>>"$TUTOR_HOME/logs/launcher.log"
}

# machine_wait_connected: poll machine_connected until the enrolled machine
# is connected, up to TUTOR_MACHINE_TIMEOUT seconds (default 60; tests set
# it low).
machine_wait_connected() {
  [ -n "$(config_get machine_id)" ] || fail "No machine is enrolled yet. Run tutor up again."
  timeout=${TUTOR_MACHINE_TIMEOUT:-60}
  waited=0
  while [ "$waited" -lt "$timeout" ]; do
    if machine_connected; then
      return 0
    fi
    waited=$((waited + 1))
    sleep 1
  done
  fail "Tutor's machine never connected. Run \`tutor logs\`."
}

# machine_create_abort <pid>: the real `bb machine create` blocks until a
# machine connects, so a caller giving up on it (enrolment line never
# appeared, couldn't be parsed, or the installer failed to download) must
# not just `wait` on it — that could hang forever. Kill it, then reap it.
machine_create_abort() {
  kill "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

# machine_installer_run: one attempt at enrolling this computer as a BB
# machine. `bb machine create` runs in the background (output ->
# enrol.out, 0600) because it blocks until the machine connects; the
# enrolment line it prints is polled for, up to TUTOR_ENROL_TIMEOUT
# seconds (default 60). The header ("X-BB-Enrollment: <token>") is
# extracted from enrol.out into a 0600 file with sed. The token sits in
# the shell variable $line, but only ever passes through printf, a
# builtin, so it never reaches an external command's argv, stdout/stderr
# or any log. BB's installer is downloaded with `curl -H @header`, run
# with its output in install.log, and deleted as soon as it has run: its
# body holds the token too (amendment 3). Once the installer has worked,
# the create gets up to TUTOR_MACHINE_TIMEOUT seconds (default 60) to
# finish before it is killed.
#
# The body runs in a subshell, so its private umask (the 0600 files) and
# its traps stay inside it. On every exit — success, failure, Ctrl-C or
# TERM — a trap deletes enrol.out, enrol.header and the installer, and
# kills the create if it is still running.
#
# Exit status: 0 success; 2 the enrolment expired or create failed (the
# caller retries once); 3 the create never finished; 1 any other
# failure; 130/143 interrupted.
machine_installer_run() (
  mkdir -p "$TUTOR_HOME" "$TUTOR_HOME/logs"
  out="$TUTOR_HOME/enrol.out"
  header="$TUTOR_HOME/enrol.header"
  installer="$TUTOR_HOME/machine-installer.sh"
  installlog="$TUTOR_HOME/install.log"
  port=$(tutor_bb_port)
  create_pid=""

  # shellcheck disable=SC2329 # invoked by the EXIT trap below
  mir_cleanup() {
    if [ -n "$create_pid" ]; then
      machine_create_abort "$create_pid"
      create_pid=""
    fi
    rm -f "$header" "$out" "$installer"
  }
  trap mir_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  umask 077
  : >"$out"
  chmod 600 "$out"
  rm -f "$header" "$installer"

  (
    BB_SERVER_URL="http://127.0.0.1:$port" "$TUTOR_HOME/server/npm/node_modules/.bin/bb" \
      machine create --provider manual --key tutor-machine
  ) >"$out" 2>&1 &
  create_pid=$!

  line=""
  waited=0
  limit=${TUTOR_ENROL_TIMEOUT:-60}
  while [ "$waited" -lt "$limit" ]; do
    line=$(grep -m1 'X-BB-Enrollment' "$out" 2>/dev/null) || line=""
    [ -n "$line" ] && break
    if ! kill -0 "$create_pid" 2>/dev/null; then
      # It has already exited (a real create exits only once connected, so
      # this is a non-blocking test double, or a real failure) — one more
      # read in case its last write landed after our check above.
      line=$(grep -m1 'X-BB-Enrollment' "$out" 2>/dev/null) || line=""
      break
    fi
    waited=$((waited + 1))
    sleep 1
  done
  [ -n "$line" ] || exit 1

  printf '%s\n' "$line" | sed -n "s/.*['\"]\\(X-BB-Enrollment:[^'\"]*\\)['\"].*/\\1/p" >"$header"
  chmod 600 "$header"
  url=$(printf '%s\n' "$line" | grep -o 'https\{0,1\}://[^ '"'"'"|]*' | head -n 1) || url=""
  { [ -s "$header" ] && [ -n "$url" ]; } || exit 1

  curl -fsSL -H @"$header" "$url" -o "$installer" 2>>"$TUTOR_HOME/logs/launcher.log" || exit 1
  chmod 600 "$installer"

  install_status=0
  sh "$installer" >"$installlog" 2>&1 || install_status=$?
  rm -f "$installer" # its body holds the enrolment token too (amendment 3)

  if [ "$install_status" -ne 0 ]; then
    # The create would wait forever for a machine that isn't coming: the
    # trap kills it.
    if grep -qi expired "$installlog" 2>/dev/null; then
      exit 2
    fi
    exit 1
  fi

  waited=0
  limit=${TUTOR_MACHINE_TIMEOUT:-60}
  while kill -0 "$create_pid" 2>/dev/null; do
    [ "$waited" -lt "$limit" ] || exit 3
    waited=$((waited + 1))
    sleep 1
  done
  create_status=0
  wait "$create_pid" || create_status=$?
  create_pid=""

  [ "$create_status" -eq 0 ] || exit 2
  exit 0
)

# machine_enrol: enrol this computer as a BB machine. Retries once, from
# `bb machine create` (the --key tutor-machine idempotency key reuses the
# creation), if the enrolment expires or the background create fails; a
# second failure gives up. Interrupted (Ctrl-C, TERM), it stops there.
machine_enrol() {
  attempt=1
  while [ "$attempt" -le 2 ]; do
    status=0
    machine_installer_run || status=$?
    if [ "$status" -eq 0 ]; then
      id=$(machine_id) || fail "Couldn't find the enrolled machine. Run tutor up again."
      config_set machine_id "$id"
      return 0
    fi
    if [ "$status" -gt 128 ]; then
      exit "$status"
    fi
    if [ "$status" -eq 3 ]; then
      fail "Tutor's machine never connected. Run \`$TUTOR_NAME logs\`."
    fi
    if [ "$status" -eq 2 ] && [ "$attempt" -eq 1 ]; then
      attempt=$((attempt + 1))
      continue
    fi
    fail "Enrolling this computer failed. Run tutor up again."
  done
}

# pi_install: install the pinned pi under $TUTOR_HOME/pi-npm, link its bin
# as $TUTOR_HOME/bin/pi (BB_PI_BRIDGE_COMMAND, which BB probes with
# --version: amendment 5), and make Tutor's private pi folder,
# $TUTOR_HOME/pi (PI_CODING_AGENT_DIR), mode 0700. Skipped when already
# installed at PI_VERSION.
pi_install() {
  mkdir -p "$TUTOR_HOME/bin" "$TUTOR_HOME/logs"
  if [ ! -d "$TUTOR_HOME/pi" ]; then
    mkdir -m 700 "$TUTOR_HOME/pi"
  fi
  chmod 700 "$TUTOR_HOME/pi"
  marker="$TUTOR_HOME/pi-npm/.pi-version"
  if [ ! -f "$marker" ] || [ "$(cat "$marker")" != "$PI_VERSION" ] || [ ! -x "$TUTOR_HOME/bin/pi" ]; then
    mkdir -p "$TUTOR_HOME/pi-npm"
    npm install --prefix "$TUTOR_HOME/pi-npm" "$PI_PACKAGE@$PI_VERSION" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
      || fail "Tutor's pi failed to install. Run \`tutor logs\`."
    printf '%s' "$PI_VERSION" >"$marker"
  fi
  ln -sf "$TUTOR_HOME/pi-npm/node_modules/.bin/pi" "$TUTOR_HOME/bin/pi"
}

# machine_service_file: the systemd user unit (Linux) or launchd plist
# (macOS) BB's installer wrote for this port's machine — the one whose text
# names .bb-machines/127.0.0.1-<port> (spike: MACHINE_UNIT_GLOB, amendment
# 9). Fails when there is none.
machine_service_file() {
  msf_port=$(tutor_bb_port)
  case "$(os_kind)" in
    linux) msf_dir="$HOME/.config/systemd/user"; msf_ext=service ;;
    macos) msf_dir="$HOME/Library/LaunchAgents"; msf_ext=plist ;;
  esac
  [ -d "$msf_dir" ] || return 1
  for msf_file in "$msf_dir"/*."$msf_ext"; do
    [ -f "$msf_file" ] || continue
    if grep -qF ".bb-machines/127.0.0.1-$msf_port" "$msf_file" 2>/dev/null; then
      printf '%s\n' "$msf_file"
      return 0
    fi
  done
  return 1
}

# provider_key_names: the names, space-separated, of the provider
# credentials the systemd user manager holds (KEY_PATTERN). Values pass
# through `cut` and are dropped there: they are never held, printed or
# logged.
provider_key_names() {
  systemctl --user show-environment 2>>"$TUTOR_HOME/logs/launcher.log" \
    | cut -d= -f1 | grep -E "$KEY_PATTERN" | tr '\n' ' ' | sed 's/ *$//' || true
}

# plist_label <plist file>: the Label a launchd plist declares.
plist_label() {
  pb=${PLISTBUDDY:-/usr/libexec/PlistBuddy}
  "$pb" -c 'Print :Label' "$1" 2>/dev/null
}

# daemon_main_pid <unit file name | plist path>: the running MainPID of a
# user service — `systemctl --user show -p MainPID --value` on Linux,
# `launchctl print`'s "pid = N" line on macOS. Empty/non-zero exit when the
# service isn't running or can't be found.
daemon_main_pid() {
  dmp_target=$1
  case "$(os_kind)" in
    linux)
      systemctl --user show -p MainPID --value "$dmp_target" 2>/dev/null
      ;;
    macos)
      dmp_label=$(plist_label "$dmp_target") || return 1
      [ -n "$dmp_label" ] || return 1
      launchctl print "gui/$(id -u)/$dmp_label" 2>/dev/null \
        | sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\).*/\1/p' | head -n 1
      ;;
  esac
}

# daemon_env_names: the names, space-separated, of provider credentials
# (KEY_PATTERN) the enrolled machine's own running service still has in its
# environment — read from the daemon itself (/proc/<MainPID>/environ on
# Linux; launchd's "environment" block on macOS), never from the drop-in or
# plist Tutor wrote. Values are dropped by `cut`/field-splitting before
# anything is printed or logged. Empty (not a failure) when the service
# isn't running or none match; fails only when no machine is enrolled.
daemon_env_names() {
  den_service=$(machine_service_file) || return 1
  case "$(os_kind)" in
    linux)
      den_pid=$(daemon_main_pid "$(basename "$den_service")") || den_pid=""
      [ -n "$den_pid" ] && [ "$den_pid" != 0 ] || { printf ''; return 0; }
      cat "/proc/$den_pid/environ" 2>/dev/null | tr '\0' '\n' \
        | cut -d= -f1 | grep -E "$KEY_PATTERN" | tr '\n' ' ' | sed 's/ *$//'
      ;;
    macos)
      den_label=$(plist_label "$den_service") || den_label=""
      [ -n "$den_label" ] || { printf ''; return 0; }
      launchctl print "gui/$(id -u)/$den_label" 2>/dev/null \
        | awk '/environment = \{/{f=1;next} /\}/{f=0} f' \
        | sed -E 's/^[[:space:]]*//; s/[[:space:]]*=.*$//' \
        | grep -E "$KEY_PATTERN" | tr '\n' ' ' | sed 's/ *$//'
      ;;
  esac
}

# listening_check: say whether the server and the machine daemon are
# listening on 127.0.0.1 only (ss -ltnp on Linux, lsof -iTCP -sTCP:LISTEN
# -P -n on macOS), restricted to their own MainPIDs (the server's from its
# unit on Linux, from its plist's label on macOS).
listening_check() {
  lc_pids=""
  case "$(os_kind)" in
    linux) lc_server=tutor-server.service ;;
    macos) lc_server=$(server_service_file) ;;
  esac
  lc_pid=$(daemon_main_pid "$lc_server") || lc_pid=""
  if [ -n "$lc_pid" ] && [ "$lc_pid" != 0 ]; then lc_pids="$lc_pid"; fi
  lc_service=$(machine_service_file) || lc_service=""
  if [ -n "$lc_service" ]; then
    lc_pid2=$(daemon_main_pid "$(basename "$lc_service")") || lc_pid2=""
    [ -n "$lc_pid2" ] && [ "$lc_pid2" != 0 ] && lc_pids="$lc_pids $lc_pid2"
  fi

  case "$(os_kind)" in
    linux) lc_raw=$(ss -ltnp 2>/dev/null) || lc_raw="" ;;
    macos) lc_raw=$(lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null) || lc_raw="" ;;
  esac

  lc_bad=""
  for lc_p in $lc_pids; do
    case "$(os_kind)" in
      linux)
        # "pid=N," so pid 4242 never matches pid 42421.
        lc_addrs=$(printf '%s\n' "$lc_raw" | grep "pid=$lc_p," | awk '{print $4}')
        ;;
      macos)
        lc_addrs=$(printf '%s\n' "$lc_raw" | awk -v p="$lc_p" '$2==p {print $9}' | sed 's#.*TCP ##; s/ (LISTEN)//')
        ;;
    esac
    for lc_addr in $lc_addrs; do
      case "$lc_addr" in
        127.0.0.1:*) ;;
        *) lc_bad="$lc_bad $lc_addr" ;;
      esac
    done
  done

  if [ -n "$lc_bad" ]; then
    say "Listening: also on$lc_bad — this is unexpected"
  else
    say "Listening: 127.0.0.1 only"
  fi
}

# plist_value <string>: a value for a PlistBuddy -c command, single-quoted
# when it holds a space (PlistBuddy splits its command on whitespace).
plist_value() {
  case "$1" in
    *" "*) printf "'%s'" "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# machine_env_apply: give the machine service Tutor's pi, as absolute paths:
# PI_CODING_AGENT_DIR=$TUTOR_HOME/pi and BB_PI_BRIDGE_COMMAND=$TUTOR_HOME/bin/pi.
# Linux: a drop-in, <unit>.d/tutor.conf, that also unsets every provider
# credential the user manager holds (amendment 4; recomputed on every run);
# daemon-reload and restart only when its content changed. macOS: the
# plist's EnvironmentVariables (PlistBuddy), then bootout + bootstrap when a
# value changed; launchd can't unset a variable, so keys are left to
# `tutor status`. Prints nothing.
machine_env_apply() {
  mkdir -p "$TUTOR_HOME/logs"
  service=$(machine_service_file) || fail "Tutor's machine service is missing. Run \`tutor up\` again."
  pi_dir="$TUTOR_HOME/pi"
  # TUTOR_PI_COMMAND is for the end-to-end test only (standalone/e2e/): a
  # wrapper that records how BB starts pi, then runs Tutor's pi.
  pi_bin="${TUTOR_PI_COMMAND:-$TUTOR_HOME/bin/pi}"

  case "$(os_kind)" in
    linux)
      dropin_dir="$service.d"
      dropin="$dropin_dir/tutor.conf"
      mkdir -p "$dropin_dir"
      keys=$(provider_key_names)
      {
        printf '[Service]\n'
        printf 'Environment=%s\n' "$(systemd_quote "PI_CODING_AGENT_DIR=$pi_dir")"
        printf 'Environment=%s\n' "$(systemd_quote "BB_PI_BRIDGE_COMMAND=$pi_bin")"
        if [ -n "$keys" ]; then
          printf 'UnsetEnvironment=%s\n' "$keys"
        fi
      } >"$dropin.new"
      if [ -f "$dropin" ] && cmp -s "$dropin.new" "$dropin"; then
        rm -f "$dropin.new"
        return 0
      fi
      # systemd reads only *.conf, so the drop-in goes in place first; if the
      # reload or restart then fails it is removed again, so the next run
      # sees a change and retries rather than trusting a daemon that never
      # got the variables.
      mv "$dropin.new" "$dropin"
      if ! systemctl --user daemon-reload >>"$TUTOR_HOME/logs/launcher.log" 2>&1; then
        rm -f "$dropin"
        fail "Tutor couldn't reload its services. Run \`tutor logs\`."
      fi
      if ! systemctl --user restart "$(basename "$service")" >>"$TUTOR_HOME/logs/launcher.log" 2>&1; then
        rm -f "$dropin"
        fail "Tutor's machine service didn't restart. Run \`tutor logs\`."
      fi
      ;;
    macos)
      pb=${PLISTBUDDY:-/usr/libexec/PlistBuddy}
      changed=0
      if ! "$pb" -c 'Print :EnvironmentVariables' "$service" >/dev/null 2>&1; then
        "$pb" -c 'Add :EnvironmentVariables dict' "$service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
          || fail "Tutor couldn't update its machine service. Run \`$TUTOR_NAME logs\`."
      fi
      for env_name in PI_CODING_AGENT_DIR BB_PI_BRIDGE_COMMAND; do
        case "$env_name" in
          PI_CODING_AGENT_DIR) env_value=$pi_dir ;;
          BB_PI_BRIDGE_COMMAND) env_value=$pi_bin ;;
        esac
        current=$("$pb" -c "Print :EnvironmentVariables:$env_name" "$service" 2>/dev/null) || current=""
        [ "$current" = "$env_value" ] && continue
        "$pb" -c "Delete :EnvironmentVariables:$env_name" "$service" >/dev/null 2>&1 || true
        "$pb" -c "Add :EnvironmentVariables:$env_name string $(plist_value "$env_value")" "$service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
          || fail "Tutor couldn't update its machine service. Run \`$TUTOR_NAME logs\`."
        changed=1
      done
      [ "$changed" -eq 1 ] || return 0
      # launchd reads the plist when it loads it: reload, don't just kickstart.
      launchctl bootout "gui/$(id -u)" "$service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      launchd_bootstrap "$service" \
        || fail "Tutor's machine service didn't restart. Run \`$TUTOR_NAME logs\`."
      ;;
  esac
}

# machine_service_start: start the enrolled machine's service (enabled by
# BB's installer, so normally running from login to logout: amendment 8).
machine_service_start() {
  service=$(machine_service_file) || fail "Tutor's machine service is missing. Run \`tutor up\` again."
  mkdir -p "$TUTOR_HOME/logs"
  case "$(os_kind)" in
    linux)
      systemctl --user start "$(basename "$service")" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
        || fail "Tutor's machine service didn't start. Run \`tutor logs\`."
      ;;
    macos)
      # Already loaded is fine: bootstrap then fails, and the wait decides.
      launchctl bootstrap "gui/$(id -u)" "$service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      ;;
  esac
}

# canonical_path <path>: <path> with its deepest existing ancestor resolved
# physically (symlinks followed) and the rest appended as given.
canonical_path() {
  cp_head=$1
  cp_tail=""
  while [ ! -d "$cp_head" ]; do
    cp_tail="/$(basename "$cp_head")$cp_tail"
    cp_head=$(dirname "$cp_head")
  done
  printf '%s%s' "$(cd "$cp_head" && pwd -P)" "$cp_tail"
}

# workspace_refuse_reserved <real path>: fail (Decision 18) for / , home
# itself, and anything inside ~/.tutor (which holds the course content too),
# ~/.bb-machines or $TUTOR_HOME.
workspace_refuse_reserved() {
  wr_real=$1
  home_real=$(canonical_path "$HOME")
  tutor_real=$(canonical_path "$TUTOR_HOME")
  case "${wr_real%/}/" in
    / | "$home_real/" | "$home_real/.tutor/"* | "$home_real/.bb-machines/"* | "$tutor_real/"*)
      fail "Tutor keeps its own files there, so it can't be your course folder. Pick a folder of its own, such as ~/my-course."
      ;;
  esac
}

# workspace_prepare <folder>: make <folder> the workspace, setting
# TUTOR_WORKSPACE to its absolute path. Refuses (Decision 18) home itself
# and anything inside ~/.tutor or ~/.bb-machines (which holds the course
# content too), and a folder that is neither empty nor a Tutor workspace
# (one with .tutor/, or holding only .git, or the folder config records as
# the workspace Tutor set up), and any path with a . or ..
# component. Creates it if missing, checks its physical path again, and
# git-inits it when it has no .git. Never deletes anything.
workspace_prepare() {
  ws=$1
  while :; do
    case "$ws" in
      ./*) ws=${ws#./} ;;
      *) break ;;
    esac
  done
  case "$ws" in
    /*) ;;
    *) ws="$(pwd)/$ws" ;;
  esac
  while [ "${ws%/}" != "$ws" ] && [ "$ws" != / ]; do ws=${ws%/}; done
  # A "." or ".." would be resolved only where the path exists, so a folder
  # still to be made could step back into home or ~/.tutor: refuse them.
  case "$ws/" in
    */./* | */../*)
      fail "Give the course folder's path without . or .., for example: $TUTOR_NAME up ~/my-course"
      ;;
  esac

  workspace_refuse_reserved "$(canonical_path "$ws")"

  if [ -e "$ws" ] && [ ! -d "$ws" ]; then
    fail "$ws is a file, not a folder. Pick a folder for your course, such as ~/my-course."
  fi
  # The folder config records is the one Tutor set up before, even if the
  # student added files before Lesson 0 wrote .tutor/.
  wp_recorded=$(config_get workspace)
  wp_ours=0
  if [ -d "$ws" ] && [ -n "$wp_recorded" ] && [ -d "$wp_recorded" ] \
    && [ "$(cd "$wp_recorded" && pwd -P)" = "$(cd "$ws" && pwd -P)" ]; then
    wp_ours=1
  fi
  if [ -d "$ws" ] && [ ! -d "$ws/.tutor" ] && [ "$wp_ours" -eq 0 ]; then
    for entry in "$ws"/* "$ws"/.[!.]* "$ws"/..?*; do
      [ -e "$entry" ] || [ -L "$entry" ] || continue
      [ "$entry" = "$ws/.git" ] && continue
      fail "$ws already has files in it. Pick an empty folder, or one Tutor set up before."
    done
  fi

  mkdir -p "$ws" "$TUTOR_HOME/logs"
  # Once it exists, check again where it really is (symlinks followed).
  workspace_refuse_reserved "$(cd "$ws" && pwd -P)"
  if [ ! -e "$ws/.git" ]; then
    git init --quiet "$ws" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 \
      || fail "Tutor couldn't set up git in $ws. Run \`tutor logs\`."
  fi
  TUTOR_WORKSPACE=$ws
}

# json_project_id: the project id ("id", or "project.id") in the JSON on
# stdin, or fail.
json_project_id() {
  node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try {
        const data = JSON.parse(raw);
        const id = data.id ?? data.project?.id;
        if (typeof id !== "string" || id === "") process.exit(1);
        console.log(id);
      } catch {
        process.exit(1);
      }
    });' 2>>"$TUTOR_HOME/logs/launcher.log"
}

# project_ensure: the project for TUTOR_WORKSPACE on the enrolled machine,
# set as Tutor's workspaceProject. Created once per folder and machine: a
# later up for the same folder (however it is spelt) on the same machine
# reuses config's project_id; a new machine (enrolled again) gets a new one.
project_ensure() {
  ws=$TUTOR_WORKSPACE
  pe_machine=$(config_get machine_id)
  project_id=$(config_get project_id)
  pe_recorded=$(config_get workspace)
  pe_same_folder=0
  if [ -n "$pe_recorded" ] && [ -d "$pe_recorded" ] \
    && [ "$(cd "$pe_recorded" && pwd -P)" = "$(cd "$ws" && pwd -P)" ]; then
    pe_same_folder=1
    ws=$pe_recorded
  fi
  if [ -z "$project_id" ] || [ "$pe_same_folder" -eq 0 ] || [ "$(config_get project_machine)" != "$pe_machine" ]; then
    json=$(tutor_bb_json project create --name "$(basename "$ws")" --root "$ws" --machine "$pe_machine" --json) \
      || fail "Tutor couldn't add your course folder. Run \`tutor logs\`."
    project_id=$(printf '%s' "$json" | json_project_id) \
      || fail "Tutor couldn't add your course folder. Run \`tutor logs\`."
  fi
  tutor_bb plugin config tutor set workspaceProject "$project_id" \
    || fail "Tutor couldn't choose your course folder. Run \`tutor logs\`."
  config_set workspace "$ws"
  config_set project_id "$project_id"
  config_set project_machine "$pe_machine"
}

# without_keys <command...>: run <command> with every provider credential
# (KEY_PATTERN) removed from its environment, the way the machine daemon
# runs (amendment 4). Names come from `env | cut`; values are never held.
# `env -u` is in GNU and BSD/macOS env alike.
without_keys() {
  for wk_name in $(env | cut -d= -f1 | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | grep -E "$KEY_PATTERN" | sort -u); do
    set -- -u "$wk_name" "$@"
  done
  env "$@"
}

# pi_ready [provider]: whether Tutor's pi is signed in to <provider>
# (default: config's provider; none recorded means not ready) — PI_READY,
# amendment 6. Asked without the student's provider keys, which the machine
# daemon doesn't get either, so a key in the shell never counts.
pi_ready() {
  ready_provider=${1:-$(config_get provider)}
  [ -n "$ready_provider" ] || return 1
  [ -x "$TUTOR_HOME/bin/pi" ] || return 1
  mkdir -p "$TUTOR_HOME/logs"
  without_keys PI_CODING_AGENT_DIR="$TUTOR_HOME/pi" "$TUTOR_HOME/bin/pi" auth check --provider "$ready_provider" \
    </dev/null >>"$TUTOR_HOME/logs/launcher.log" 2>&1
}

# first_model <provider>: the id of the first of <provider>'s models in the
# machine's pi model list (rows whose routeProviderId is <provider>), or
# fail.
# default_model <provider>: the coach's model when the student doesn't pick
# one, for the providers Tutor has a choice for.
default_model() {
  case "$1" in
    openrouter) echo openrouter/z-ai/glm-5.3-flash ;;
    *) return 1 ;;
  esac
}

first_model() {
  fm_machine=$(config_get machine_id)
  [ -n "$fm_machine" ] || fm_machine=$(machine_id) || return 1
  json=$(tutor_bb_json provider models pi --machine "$fm_machine" --json) || return 1
  printf '%s' "$json" | TUTOR_PROVIDER="$1" node -e '
    let raw = ""; process.stdin.on("data", (c) => (raw += c)).on("end", () => {
      try {
        const data = JSON.parse(raw);
        const rows = Array.isArray(data) ? data : (data.models ?? []);
        const row = rows.find((r) => r.routeProviderId === process.env.TUTOR_PROVIDER && typeof r.id === "string");
        if (row === undefined) process.exit(1);
        console.log(row.id);
      } catch {
        process.exit(1);
      }
    });' 2>>"$TUTOR_HOME/logs/launcher.log"
}

# login_fail <message>: say it on stderr and return 1, without exiting, so
# a caller can carry on.
login_fail() {
  say "$1" >&2
  return 1
}

# cmd_login [--provider <p>] [--model <m>]: run Tutor's pi interactively
# (stdin is the terminal) with PI_CODING_AGENT_DIR=$TUTOR_HOME/pi, so the
# student signs it in with /login; then record the provider (--provider, or
# asked), check pi is signed in to it, and pin coach threads to a model of
# it: --model, else Tutor's choice for that provider (default_model), else
# the first in the machine's model list. BB caches that list, so it is asked
# a few times (TUTOR_MODEL_RETRIES, default 5, every TUTOR_MODEL_RETRY_SLEEP
# seconds, default 3) before leaving the model to pi.
cmd_login() {
  login_provider=""
  login_model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --provider) [ $# -ge 2 ] || login_fail "--provider needs a provider name." || return 1; login_provider=$2; shift 2 ;;
      --model) [ $# -ge 2 ] || login_fail "--model needs a model name." || return 1; login_model=$2; shift 2 ;;
      *) login_fail "Usage: $TUTOR_NAME login [--provider <name>] [--model <name>]" || return 1 ;;
    esac
  done

  pi_install
  say "Tutor opens pi to sign in. Type /login, pick your provider and sign in, then type /quit."
  PI_CODING_AGENT_DIR="$TUTOR_HOME/pi" "$TUTOR_HOME/bin/pi" \
    || login_fail "Signing in didn't finish. Run \`$TUTOR_NAME login\` again." || return 1

  if [ -z "$login_provider" ]; then
    printf 'Which provider did you sign in to (for example openrouter or anthropic)? '
    read -r login_provider || login_provider=""
  fi
  case "$login_provider" in
    "" | *[!A-Za-z0-9._-]*)
      login_fail "Tutor needs the provider's name, such as openrouter. Run \`$TUTOR_NAME login\` again." || return 1
      ;;
  esac
  pi_ready "$login_provider" \
    || login_fail "Tutor's pi isn't signed in to $login_provider. Run \`$TUTOR_NAME login\` again." || return 1
  config_set provider "$login_provider"

  if [ -n "$login_model" ]; then
    case "$login_model" in
      "$login_provider"/*) ;;
      *) login_model="$login_provider/$login_model" ;;
    esac
  elif login_model=$(default_model "$login_provider"); then
    :
  else
    tries=${TUTOR_MODEL_RETRIES:-5}
    try=1
    while :; do
      login_model=$(first_model "$login_provider") && break
      login_model=""
      [ "$try" -lt "$tries" ] || break
      try=$((try + 1))
      sleep "${TUTOR_MODEL_RETRY_SLEEP:-3}"
    done
  fi

  config_set model "$login_model"
  if [ -z "$login_model" ]; then
    tutor_bb plugin config tutor set coachModel "" || true
    say "Signed in to $login_provider. Tutor couldn't list its models yet, so the coach uses pi's default model. Run \`$TUTOR_NAME login --provider $login_provider\` later to choose one."
    return 0
  fi
  tutor_bb plugin config tutor set coachModel "$login_model" \
    || login_fail "Tutor couldn't set the coach's model. Run \`$TUTOR_NAME logs\`." || return 1
  say "Signed in to $login_provider. The coach uses $login_model."
}

# cmd_open: open Tutor in the browser (xdg-open on Linux, open on macOS),
# always saying the address too.
cmd_open() {
  url="http://127.0.0.1:$(tutor_bb_port)"
  mkdir -p "$TUTOR_HOME/logs"
  case "$(os_kind)" in
    linux) opener=xdg-open ;;
    macos) opener=open ;;
  esac
  "$opener" "$url" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
  say "Tutor is open at $url"
}

# cmd_up [--port <n>] [folder]: start or resume everything, then open the
# browser. Safe to run again: what is done is skipped, what changed is
# repaired.
cmd_up() {
  up_port=""
  up_folder=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) fail "$TUTOR_NAME up --server is not available yet." ;;
      --port)
        [ $# -ge 2 ] || fail "--port needs a port number."
        up_port=$2
        shift 2
        ;;
      --port=*) up_port=${1#--port=}; shift ;;
      -*) fail "Usage: $TUTOR_NAME up [--port <n>] [folder]" ;;
      *) up_folder=$1; shift ;;
    esac
  done
  [ -n "$up_port" ] || up_port=$(tutor_bb_port)
  case "$up_port" in
    "" | *[!0-9]* | 0*) fail "--port needs a port number from 1 to 65535." ;;
  esac
  [ "${#up_port}" -le 5 ] && [ "$up_port" -le 65535 ] \
    || fail "--port needs a port number from 1 to 65535."

  os_kind >/dev/null
  check_prereqs
  # Every later call to the server reads the port from config.
  config_set port "$up_port"

  [ -n "$up_folder" ] || up_folder=$(config_get workspace)
  [ -n "$up_folder" ] || fail "Say where your course goes, for example: $TUTOR_NAME up ~/my-course"
  workspace_prepare "$up_folder"

  say "Starting Tutor's server..."
  server_install
  server_service_write "$up_port"
  server_start
  server_wait_healthy "$up_port"
  server_configure "$up_port"
  plugin_install
  tutor_polish

  # A machine service for this port must exist too: after `--port` changes
  # the port, the machine enrolled for the old one isn't this one's.
  if machine_service_file >/dev/null && machine_connected; then
    :
  elif [ -n "$(config_get machine_id)" ] && machine_service_file >/dev/null; then
    machine_service_start # enrolled before, just not running (after a stop)
  else
    say "Connecting Tutor to this computer..."
    machine_enrol
  fi
  pi_install
  machine_env_apply
  machine_wait_connected
  project_ensure

  if ! pi_ready; then
    say "Run \`$TUTOR_NAME login\` to connect Tutor to a model provider."
  fi
  cmd_open
}

# cmd_status: say the server's, the machine's, the workspace's, the model
# provider's and the listening sockets' state, plus any provider credential
# names (never values) still reaching Tutor's agents (amendment 4).
cmd_status() {
  mkdir -p "$TUTOR_HOME/logs"
  st_port=$(tutor_bb_port)

  if curl -fsS "http://127.0.0.1:$st_port/health" >/dev/null 2>&1; then
    say "Server: healthy"
  else
    say "Server: stopped"
  fi

  if machine_connected; then
    say "Machine: connected"
  else
    say "Machine: not connected"
  fi

  say "Workspace: $(config_get workspace)"

  st_provider=$(config_get provider)
  if [ -n "$st_provider" ] && pi_ready "$st_provider"; then
    say "Model provider: $st_provider signed in"
  elif [ -n "$st_provider" ]; then
    say "Model provider: $st_provider not signed in — run \`$TUTOR_NAME login\`"
  else
    say "Model provider: not signed in — run \`$TUTOR_NAME login\`"
  fi

  st_keys=$(daemon_env_names) || st_keys=""
  if [ -z "$st_keys" ]; then
    say "Other model keys: none"
  else
    case "$(os_kind)" in
      linux)
        say "Other model keys: $st_keys reach Tutor's agents — run \`$TUTOR_NAME up\` to remove them."
        ;;
      macos)
        say "Other model keys: $st_keys reach Tutor's agents — they come from your own launchd environment (\`launchctl getenv <name>\`) or your shell profile; remove them there."
        ;;
    esac
  fi

  listening_check
}

# cmd_stop: stop both services without removing anything — a later
# `tutor up` starts them again.
cmd_stop() {
  mkdir -p "$TUTOR_HOME/logs"
  sp_service=$(machine_service_file) || sp_service=""
  case "$(os_kind)" in
    linux)
      if [ -n "$sp_service" ]; then
        systemctl --user stop "$(basename "$sp_service")" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      fi
      systemctl --user stop tutor-server.service >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      ;;
    macos)
      if [ -n "$sp_service" ]; then
        launchctl bootout "gui/$(id -u)" "$sp_service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      fi
      launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/$SERVER_LABEL.plist" \
        >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      ;;
  esac
  say "Tutor is stopped. Run \`$TUTOR_NAME up\` to start it again."
}

# cmd_logs: the last 200 lines of the launcher's own log (every step's
# details: npm, systemctl/launchctl, bb), and of the server's, the
# machine's and the machine installer's logs. The one command allowed to
# say "bb" (common.md).
cmd_logs() {
  lg_port=$(tutor_bb_port)
  tail -n 200 "$TUTOR_HOME/logs/launcher.log" 2>/dev/null || true
  tail -n 200 "$TUTOR_HOME/server/logs/server-stdio.log" 2>/dev/null || true
  tail -n 200 "$HOME/.bb-machines/127.0.0.1-$lg_port/logs/host-daemon-stdio.log" 2>/dev/null || true
  tail -n 200 "$TUTOR_HOME/install.log" 2>/dev/null || true
  return 0
}

# purge_check: fail unless $TUTOR_HOME is safe to delete whole — it isn't
# /, isn't home itself, and holds Tutor's config file (TUTOR_HOME comes from
# the environment, so it could name anything).
purge_check() {
  [ -e "$TUTOR_HOME" ] || return 0
  pc_real=$(cd "$TUTOR_HOME" 2>/dev/null && pwd -P) || pc_real=""
  pc_home=$(cd "$HOME" 2>/dev/null && pwd -P) || pc_home=$HOME
  case "$pc_real" in
    "" | / | "$pc_home")
      fail "Tutor won't delete $TUTOR_HOME: it isn't Tutor's own folder. Nothing was removed."
      ;;
  esac
  [ -f "$TUTOR_HOME/config" ] \
    || fail "Tutor won't delete $TUTOR_HOME: it has no Tutor config in it. Nothing was removed."
}

# cmd_uninstall [--purge]: remove the enrolment (bb machine remove,
# best-effort — the server may be down), the machine's own service file and
# drop-in/plist, and the tutor server's service file; with --purge also the
# machine directory and ~/.tutor. Never the workspace, ~/.pi or the
# student's own ~/.bb (amendment 3); ~/.bb/pi-bridge-sessions is left behind
# on purpose, per the spike notes — it isn't Tutor's to delete.
cmd_uninstall() {
  un_purge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) un_purge=1; shift ;;
      *) fail "Usage: $TUTOR_NAME uninstall [--purge]" ;;
    esac
  done
  # Before anything is removed: --purge deletes $TUTOR_HOME whole.
  [ "$un_purge" -eq 0 ] || purge_check

  mkdir -p "$TUTOR_HOME/logs"
  un_port=$(tutor_bb_port)
  un_id=$(config_get machine_id)
  if [ -n "$un_id" ]; then
    tutor_bb machine remove "$un_id" --yes || true
  fi

  un_service=$(machine_service_file) || un_service=""
  case "$(os_kind)" in
    linux)
      if [ -n "$un_service" ]; then
        systemctl --user stop "$(basename "$un_service")" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
        systemctl --user disable "$(basename "$un_service")" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
        rm -rf "$un_service.d"
        rm -f "$un_service"
      fi
      systemctl --user stop tutor-server.service >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      systemctl --user disable tutor-server.service >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      rm -f "$HOME/.config/systemd/user/tutor-server.service"
      systemctl --user daemon-reload >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      ;;
    macos)
      if [ -n "$un_service" ]; then
        launchctl bootout "gui/$(id -u)" "$un_service" >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
        rm -f "$un_service"
      fi
      launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/$SERVER_LABEL.plist" \
        >>"$TUTOR_HOME/logs/launcher.log" 2>&1 || true
      rm -f "$HOME/Library/LaunchAgents/$SERVER_LABEL.plist"
      ;;
  esac

  if [ "$un_purge" -eq 1 ]; then
    rm -rf "$TUTOR_HOME"
    rm -rf "$HOME/.bb-machines/127.0.0.1-$un_port"
  fi

  say "Tutor is uninstalled."
}

print_help() {
  say "Usage: $TUTOR_NAME <command> [options]"
  say ""
  say "Commands:"
  say "  $TUTOR_NAME up [path]   Install and start the course at path."
  say "  $TUTOR_NAME login       Sign the coach in to a provider."
  say "  $TUTOR_NAME open        Open the course in your browser."
  say "  $TUTOR_NAME status      Show whether the course is running."
  say "  $TUTOR_NAME stop        Stop the course."
  say "  $TUTOR_NAME logs        Show recent log lines."
  say "  $TUTOR_NAME uninstall   Remove everything $TUTOR_NAME installed."
  say "  $TUTOR_NAME help        Show this help."
}

# main: dispatch up | login | open | status | stop | logs | uninstall | help.
main() {
  cmd=${1:-help}
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    up)
      cmd_up "$@"
      ;;
    login)
      cmd_login "$@"
      ;;
    open)
      cmd_open
      ;;
    status)
      cmd_status
      ;;
    stop)
      cmd_stop
      ;;
    logs)
      cmd_logs
      ;;
    uninstall)
      cmd_uninstall "$@"
      ;;
    help | -h | --help)
      print_help
      ;;
    *)
      print_help >&2
      exit 1
      ;;
  esac
}

[ "${TUTOR_SOURCE_ONLY:-}" = 1 ] || main "$@"
