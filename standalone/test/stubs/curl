#!/bin/sh
# A quiet, successful curl; STUB_CURL_FAIL=1 makes every call fail, as a
# server that never becomes healthy would.
#
# When called with `-o <file>` (the launcher downloading the machine
# installer), it writes a fake installer to <file> instead: it prints
# "installer says hello", touches $HOME/.stub-installed, and — while
# STUB_INSTALLER_EXPIRED_TIMES copies of the expiry remain — exits 3 after
# saying the enrolment expired. The remaining count is tracked in a file
# under $STUB_LOG so it survives across the launcher's retries.
#
# STUB_CURL_HOOK, if set, is eval'd and its output appended to
# $STUB_LOG/curl-hook — used to observe state (e.g. the header file's mode)
# at the moment curl runs.
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init "curl" "$@"

if [ -n "${STUB_CURL_HOOK:-}" ]; then
  eval "$STUB_CURL_HOOK" >>"$STUB_LOG/curl-hook"
fi

if [ "${STUB_CURL_FAIL:-}" = 1 ]; then
  exit 1
fi

out=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-o" ]; then
    out="$arg"
  fi
  prev="$arg"
done

if [ -n "$out" ]; then
  cat >"$out" <<'INSTALLER'
#!/bin/sh
echo "installer says hello"
touch "$HOME/.stub-installed"
state="$STUB_LOG/.installer-expired-remaining"
if [ ! -f "$state" ]; then
  printf '%s' "${STUB_INSTALLER_EXPIRED_TIMES:-0}" >"$state"
fi
remaining=$(cat "$state")
if [ "$remaining" -gt 0 ] 2>/dev/null; then
  remaining=$((remaining - 1))
  printf '%s' "$remaining" >"$state"
  echo "enrollment expired" >&2
  exit 3
fi
exit 0
INSTALLER
  chmod +x "$out"
fi
