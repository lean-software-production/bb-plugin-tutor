#!/bin/sh
# A quiet, successful git; STUB_MISSING=git makes it behave as absent.
# `git init [options] <dir>` creates <dir>/.git, as the real one would.
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init git "$@"
case "${1:-}" in
  --version) echo "git version 2.43.0" ;;
  init)
    dir=.
    for arg in "$@"; do dir=$arg; done
    mkdir -p "$dir/.git"
    ;;
  *) : ;;
esac
