#!/bin/sh
# Placeholder stub for later launcher tasks: logs argv, quiet, exit 0 unless
# listed in $STUB_MISSING. Behaviour is scripted per-test via STUB_<NAME>_*.
#
# `machine create`: writes its own pid to $STUB_LOG/bb.pid (so a test can
# confirm it was killed, not left running), then writes an enrolment line
# (with STUB_ENROL_TOKEN, default stub-enrol-token) to its own stdout —
# never to $STUB_LOG; its URL is $BB_SERVER_URL's — then, only when STUB_BB_CREATE_BLOCKS_UNTIL_INSTALLED
# =1, blocks until $HOME/.stub-installed exists (proving the launcher can't
# deadlock waiting on it synchronously, and must kill it if it gives up
# first). STUB_BB_NO_ENROL_LINE=1 prints nothing (the line never appears);
# STUB_BB_CREATE_BLOCKS_FOREVER=1 blocks for 10 s whatever happens (a
# create that never sees its machine connect). STUB_BB_BAD_ENROL_LINE=1 prints a line with "X-BB-Enrollment" but no
# quoted header or URL (the line can't be parsed).
# `machine list --json`: a single manual machine, with `status` — the real
# API's field, not a boolean — taken from STUB_MACHINE_STATUS (default
# connected); STUB_MACHINE_LIST_JSON, when set, is printed instead.
# `project create ... --json`: {"id":"prj_stub"}.
# `provider models pi ... --json`: one row per id in STUB_PROVIDER_MODELS
# (space-separated provider/model ids; default openrouter/moonshotai/kimi-k2.6),
# routeProviderId being the part before the first "/".
# `plugin list --json`: {"plugins": [...]}, holding plugin "tutor" with
# rootDir $STUB_PLUGIN_ROOT when that is set, and nothing otherwise.
# STUB_PLUGINS="<id>:on|off ..." adds those plugins to `plugin list --json`.
# `theme show --json`: {"themeId": STUB_THEME (default "default")}; `theme
# show <id> --json` fails for STUB_THEME_MISSING.
# STUB_BB_FAIL="<word1> <word2>" makes that command (e.g. "plugin install")
# print STUB_BB_FAIL_STDOUT, if set, on stdout, say why on stderr, and exit 1.
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init "bb" "$@"
env | sed -n 's/^\(BB_[A-Za-z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ' >>"$STUB_LOG/bb-env"; echo >>"$STUB_LOG/bb-env"

if [ -n "${STUB_BB_FAIL:-}" ] && [ "${1:-} ${2:-}" = "$STUB_BB_FAIL" ]; then
  [ -z "${STUB_BB_FAIL_STDOUT:-}" ] || printf '%s\n' "$STUB_BB_FAIL_STDOUT"
  echo "bb: $STUB_BB_FAIL failed" >&2
  exit 1
fi

case "${1:-} ${2:-}" in
  "plugin list")
    printf '{"plugins":['
    sep=""
    if [ -n "${STUB_PLUGIN_ROOT:-}" ]; then
      printf '{"id":"tutor","version":"0.0.0","enabled":true,"status":"ready","source":"path","rootDir":"%s"}' "$STUB_PLUGIN_ROOT"
      sep=","
    fi
    for entry in ${STUB_PLUGINS:-}; do
      [ "${entry%%:*}" = tutor ] && [ -n "${STUB_PLUGIN_ROOT:-}" ] && continue
      enabled=true
      [ "${entry#*:}" = off ] && enabled=false
      printf '%s{"id":"%s","enabled":%s}' "$sep" "${entry%%:*}" "$enabled"
      sep=","
    done
    printf ']}\n'
    ;;
  "theme show")
    if [ -n "${3:-}" ] && [ "$3" != --json ]; then
      [ "$3" = "${STUB_THEME_MISSING:-}" ] && { echo "bb: no theme $3" >&2; exit 1; }
      printf '{"themeId":"%s"}\n' "$3"
    else
      printf '{"themeId":"%s"}\n' "${STUB_THEME:-default}"
    fi
    ;;
  "machine create")
    echo $$ >"$STUB_LOG/bb.pid"
    token="${STUB_ENROL_TOKEN:-stub-enrol-token}"
    if [ "${STUB_BB_NO_ENROL_LINE:-}" = 1 ]; then
      : # the line never appears
    elif [ "${STUB_BB_BAD_ENROL_LINE:-}" = 1 ]; then
      printf 'X-BB-Enrollment: %s no-url-here\n' "$token"
    else
      printf "Run: curl -H 'X-BB-Enrollment: %s' %s/install.sh | sh\n" "$token" "${BB_SERVER_URL:-http://127.0.0.1:47386}"
    fi
    if [ "${STUB_BB_CREATE_BLOCKS_FOREVER:-}" = 1 ]; then
      i=0
      while [ "$i" -lt 100 ]; do
        i=$((i + 1))
        sleep 0.1
      done
    elif [ "${STUB_BB_CREATE_BLOCKS_UNTIL_INSTALLED:-}" = 1 ]; then
      i=0
      while [ "$i" -lt 100 ]; do
        [ -e "$HOME/.stub-installed" ] && break
        i=$((i + 1))
        sleep 0.1
      done
    fi
    exit 0
    ;;
  "project create")
    echo '{"id":"prj_stub","name":"stub"}'
    ;;
  "provider models")
    printf '['
    sep=""
    for model in ${STUB_PROVIDER_MODELS-openrouter/moonshotai/kimi-k2.6}; do
      printf '%s{"id":"%s","routeProviderId":"%s"}' "$sep" "$model" "${model%%/*}"
      sep=","
    done
    printf ']\n'
    ;;
  "machine list")
    if [ -n "${STUB_MACHINE_LIST_JSON:-}" ]; then
      printf '%s\n' "$STUB_MACHINE_LIST_JSON"
      exit 0
    fi
    printf '[{"id":"stub-machine-id","machineProviderId":"manual","createdAt":1,"status":"%s"}]\n' "${STUB_MACHINE_STATUS:-connected}"
    ;;
esac
