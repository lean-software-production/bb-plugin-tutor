#!/bin/sh
# cat is a real, heavily used command (config_set, version markers, ...), so
# this stub only fakes one specific read: /proc/<pid>/environ, the way
# daemon_env_names (Task 19) reads a running service's environment. When
# $STUB_DAEMON_ENV is set, that read is answered from it (NUL-separated, as
# the kernel would write it) without touching any real /proc. Every other
# call — any other path, or /proc/.../environ with no STUB_DAEMON_ENV set —
# delegates to the real cat found later on PATH (the node stub's pattern),
# so ordinary file reads elsewhere in the launcher are unaffected.
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init cat "$@"

case "${1:-}" in
  /proc/*/environ)
    if [ -n "${STUB_DAEMON_ENV:-}" ]; then
      printf '%s' "$STUB_DAEMON_ENV" | tr '\n' '\0'
      exit 0
    fi
    ;;
esac

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
saved_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ -n "$dir" ] || continue
  [ -f "$dir/cat" ] && [ -x "$dir/cat" ] || continue
  dir_real="$(cd "$dir" 2>/dev/null && pwd -P)" || continue
  [ "$dir_real" = "$self_dir" ] && continue
  IFS=$saved_ifs
  exec "$dir/cat" "$@"
done
IFS=$saved_ifs
echo "cat stub: no real cat found on PATH" >&2
exit 1
