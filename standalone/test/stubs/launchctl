#!/bin/sh
# launchctl, with just enough state to behave like launchd's: it remembers
# which plists are loaded (one file per plist under $STUB_LOG/launchd/,
# named after the plist's basename without .plist).
#
# `bootstrap <domain> <plist>`: loads it; when it is already loaded, fails
# as launchd does ("Bootstrap failed: 5: Input/output error", exit 5).
# STUB_LAUNCHCTL_FAIL=bootstrap makes every bootstrap fail that way.
# `bootout <domain> <plist>`: unloads it (exit 0 either way, quietly).
# `kickstart [-k] <domain>/<label>`: logged only.
# `print gui/<uid>/<label>`: fails (113, "Could not find service") unless a
# loaded plist's name starts with <label>; otherwise prints the MainPID
# ("pid = N": $STUB_SERVER_PID for Tutor's server label when set, else
# STUB_MAIN_PID, default 4242) and, when STUB_DAEMON_ENV is set, an
# "environment = { ... }" block built from it — daemon_main_pid and
# daemon_env_names' macOS path (Task 19).
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init "launchctl" "$@"

state="$STUB_LOG/launchd"
mkdir -p "$state"

case "${1:-}" in
  bootstrap)
    name=$(basename "${3:-}" .plist)
    if [ "${STUB_LAUNCHCTL_FAIL:-}" = bootstrap ] || [ -e "$state/$name" ]; then
      echo "Bootstrap failed: 5: Input/output error" >&2
      exit 5
    fi
    : >"$state/$name"
    ;;
  bootout)
    rm -f "$state/$(basename "${3:-}" .plist)"
    ;;
  print)
    label=${2##*/}
    found=""
    for f in "$state"/*; do
      [ -e "$f" ] || continue
      case "$(basename "$f")" in
        "$label"*) found=1 ;;
      esac
    done
    if [ -z "$found" ]; then
      echo "Could not find service \"$label\" in domain for user gui: 501" >&2
      exit 113
    fi
    if [ -n "${STUB_DAEMON_ENV:-}" ]; then
      printf 'environment = {\n'
      printf '%s\n' "$STUB_DAEMON_ENV" | while IFS='=' read -r env_name env_value; do
        [ -n "$env_name" ] || continue
        printf '\t%s = %s\n' "$env_name" "$env_value"
      done
      printf '}\n'
    fi
    pid=${STUB_MAIN_PID:-4242}
    if [ "$label" = com.leansoftwareproduction.tutor-server ] && [ -n "${STUB_SERVER_PID:-}" ]; then
      pid=$STUB_SERVER_PID
    fi
    printf 'pid = %s\n' "$pid"
    ;;
esac
exit 0
