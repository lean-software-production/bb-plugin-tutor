#!/bin/sh
# A quiet, successful npm; STUB_MISSING=npm makes it behave as absent.
# `install --prefix <dir> @earendil-works/pi-coding-agent@<v>` puts the pi
# stub where npm would have linked pi's bin: <dir>/node_modules/.bin/pi.
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"
stub_init npm "$@"
case "${1:-}" in
  --version) echo "10.9.0" ;;
  install)
    if [ "${2:-}" = --prefix ]; then
      case "${4:-}" in
        @earendil-works/pi-coding-agent@*)
          here="$(cd "$(dirname "$0")" && pwd)"
          mkdir -p "$3/node_modules/.bin"
          cp "$here/pi" "$3/node_modules/.bin/"
          chmod +x "$3/node_modules/.bin/pi"
          ;;
      esac
    fi
    ;;
  *) : ;;
esac
