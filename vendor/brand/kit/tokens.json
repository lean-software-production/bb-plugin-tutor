{
  "color": {
    "mustard": "#EEA306",
    "teal": "#039695",
    "forest": "#4A7D4B",
    "coral": "#F76C37",
    "blue": "#1F78A8",
    "slate": "#36545C",
    "rust": "#D6631C",
    "deep-teal": "#094854",
    "highlighter": "#FFEEB8",
    "paper": "#FCF9F3",
    "ribbon": "#FAEED3",
    "bubble": "#EEF4F5",
    "ink": "#2A2724",
    "ink-title": "#1B1B1B",
    "body-text": "#3A3631"
  },
  "font": {
    "title": "'Luckiest Guy', 'Patrick Hand SC', cursive",
    "label": "'Patrick Hand SC', 'Patrick Hand', cursive",
    "body": "'Patrick Hand', 'Comic Sans MS', cursive"
  },
  "line": {
    "thin": "3px",
    "chunky": "5px"
  },
  "wobble": {
    "thin": {
      "baseFrequency": 0.035,
      "scale": 3.5,
      "use": "bubbles, panels, arrows, doodles"
    },
    "chunky": {
      "baseFrequency": 0.04,
      "scale": 4.5,
      "use": "character outlines (~5px)"
    },
    "soft": {
      "baseFrequency": 0.02,
      "scale": 5.5,
      "use": "highlighter swashes, big loop arrows"
    }
  },
  "role": {
    "page": {
      "light": "var(--sk-paper)",
      "dark": "var(--sk-ink)",
      "use": "The page behind everything."
    },
    "text": {
      "light": "var(--sk-body-text)",
      "dark": "var(--sk-paper)",
      "use": "Sentences and captions."
    },
    "title-text": {
      "light": "var(--sk-ink-title)",
      "dark": "var(--sk-paper)",
      "use": "Big title lettering and its burst ticks."
    },
    "line": {
      "light": "var(--sk-ink)",
      "dark": "color-mix(in oklab, var(--sk-paper) 85%, var(--sk-ink))",
      "use": "Outlines of bubbles and secondary buttons."
    },
    "heading": {
      "light": "var(--sk-deep-teal)",
      "dark": "color-mix(in oklch, var(--sk-teal) 80%, var(--sk-paper))",
      "use": "Section headings and their rules, primary buttons. The lighter teal in dark mode."
    },
    "on-heading": {
      "light": "var(--sk-paper)",
      "dark": "var(--sk-ink)",
      "use": "Text on a primary button."
    },
    "connector": {
      "light": "var(--sk-slate)",
      "dark": "color-mix(in oklch, var(--sk-slate) 60%, var(--sk-paper))",
      "use": "Connector arrows between steps."
    },
    "loop": {
      "light": "var(--sk-blue)",
      "dark": "color-mix(in oklch, var(--sk-blue) 75%, var(--sk-paper))",
      "use": "The loop-back arrow."
    },
    "bubble-fill": {
      "light": "var(--sk-bubble)",
      "dark": "color-mix(in oklab, var(--sk-bubble) 12%, var(--sk-ink))",
      "use": "Speech bubble fill."
    },
    "swash": {
      "light": "var(--sk-highlighter)",
      "dark": "color-mix(in srgb, var(--sk-heading) 32%, var(--sk-ink))",
      "use": "What the highlighter swash reads as: a solid colour for tints and contrast checks. A pale-teal tint in dark mode."
    },
    "track": {
      "light": "color-mix(in oklab, var(--sk-ink) 12%, var(--sk-paper))",
      "dark": "color-mix(in oklab, var(--sk-paper) 16%, var(--sk-ink))",
      "use": "The empty part of a progress meter."
    },
    "patch": {
      "light": "transparent",
      "dark": "var(--sk-paper)",
      "use": "The paper patch behind a drawing: nothing in light mode, cream paper in dark mode."
    },
    "wash-amount": {
      "light": "9%",
      "dark": "10%",
      "use": "How much of the accent goes into a panel wash."
    },
    "mustard-text": {
      "light": "color-mix(in oklch, var(--sk-mustard) 55%, var(--sk-ink))",
      "dark": "var(--sk-mustard)",
      "use": "Mustard that reads as text."
    },
    "teal-text": {
      "light": "color-mix(in oklch, var(--sk-teal) 70%, var(--sk-ink))",
      "dark": "color-mix(in oklch, var(--sk-teal) 80%, var(--sk-paper))",
      "use": "Teal that reads as text."
    },
    "forest-text": {
      "light": "color-mix(in oklch, var(--sk-forest) 85%, var(--sk-ink))",
      "dark": "color-mix(in oklch, var(--sk-forest) 60%, var(--sk-paper))",
      "use": "Forest that reads as text. Ticks."
    },
    "coral-text": {
      "light": "color-mix(in oklch, var(--sk-coral) 55%, var(--sk-ink))",
      "dark": "color-mix(in oklch, var(--sk-coral) 80%, var(--sk-paper))",
      "use": "Coral that reads as text."
    },
    "blue-text": {
      "light": "color-mix(in oklch, var(--sk-blue) 85%, var(--sk-ink))",
      "dark": "color-mix(in oklch, var(--sk-blue) 60%, var(--sk-paper))",
      "use": "Blue that reads as text."
    },
    "rust-text": {
      "light": "color-mix(in oklch, var(--sk-rust) 70%, var(--sk-ink))",
      "dark": "color-mix(in oklch, var(--sk-rust) 65%, var(--sk-paper))",
      "use": "Rust that reads as text: bubble accents, ribbon kickers."
    },
    "deep-teal-text": {
      "light": "var(--sk-deep-teal)",
      "dark": "color-mix(in oklch, var(--sk-teal) 80%, var(--sk-paper))",
      "use": "Deep teal that reads as text. The lighter teal in dark mode."
    }
  }
}