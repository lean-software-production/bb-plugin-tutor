{
  "name": "bb-plugin-tutor",
  "version": "0.2.0",
  "private": true,
  "description": "Tutor: a coached, Gherkin-driven course inside BB.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lean-software-production/bb-plugin-tutor.git"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.43.4",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Tutor",
    "description": "A coached, Gherkin-driven course: a course outline in the sidebar and a coach thread per lesson that works one Rule at a time.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "themes": [
      {
        "id": "sketchbook",
        "name": "Sketchbook",
        "description": "The Sketchbook brand: cream paper, ink, deep teal and handwriting.",
        "css": "./themes/sketchbook.css",
        "codeTheme": {
          "light": "./themes/sketchbook-code-light.json",
          "dark": "./themes/sketchbook-code-light.json"
        }
      },
      {
        "id": "paper",
        "name": "Tutor paper (now Sketchbook)",
        "description": "The old name for Sketchbook, kept so an existing choice still works. It goes away in the next release: pick Sketchbook instead.",
        "css": "./themes/sketchbook.css",
        "codeTheme": {
          "light": "./themes/sketchbook-code-light.json",
          "dark": "./themes/sketchbook-code-light.json"
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"app/**/*.test.ts\" \"test/**/*.test.ts\" \"scripts/*.test.ts\"",
    "build": "bb plugin build .",
    "sync-brand": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/sync-brand.ts",
    "build:assets": "node --experimental-strip-types --no-warnings=ExperimentalWarning app/fonts/embed.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning app/theme/build.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning app/sketch/build-kit.ts && node --experimental-strip-types --no-warnings=ExperimentalWarning app/sketch/build-assets.ts",
    "fonts": "npm run build:assets"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
